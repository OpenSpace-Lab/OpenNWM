# Prefer: python setup_paths.py --help
# Copy to .env, edit paths, then: source .env
export LAM_PYTHON=/path/to/envs/open-lam/bin/python
export NWM_PYTHON=/path/to/envs/open-nwm/bin/python
export NWM_DATA_ROOT=/data/navigation
export NWM_SPLIT_ROOT=/data/opennwm/splits
export OPENNWM_WORK_ROOT=/data/opennwm
export NWM_OUTPUT_ROOT=/data/opennwm/runs/nwm
export NWM_VAE_PATH=/data/models/sd-vae-ft-ema
export DINO_REPO_PATH=/data/models/dinov3
export DINO_WEIGHTS_PATH=/data/models/dinov3_vitl16.pth
export NWM_NAVANYWHERE_ROOT=/data/navigation/NavAnywhere
export NWM_NAVANYWHERE_RECIPE=/data/opennwm/recipes/navanywhere_v1_13src_train_seed20260901.json
export NWM_NAVANYWHERE_VAL_RECIPE=/data/opennwm/recipes/navanywhere_v1_13src_val_seed20260901.json
export NWM_NAVANYWHERE_VAE_LATENT_ROOT=/data/opennwm/cache/nav-vae
export NWM_LATENT_PROXY_ROOT=/data/opennwm/cache/nav-train-lam
export NWM_NAVANYWHERE_VAL_PROXY_ROOT=/data/opennwm/cache/nav-val-lam
export NWM_FINETUNE_VAE_LATENT_ROOT=/data/opennwm/cache/nwm-vae
export NWM_FINETUNE_LATENT_ROOT=/data/opennwm/cache/nwm-lam
export LAM_ACTION_CHECKPOINT=/data/opennwm/models/lam-action-100000.ckpt
export LAM_PIXEL_ACTION_CHECKPOINT=/data/opennwm/models/lam-pixel-action-100000.ckpt
export NWM_STAGE1_CHECKPOINT=/data/opennwm/models/nwm-latentpt-200000.pth.tar
export HF_HOME=/data/opennwm/cache/huggingface
export TORCH_HOME=/data/opennwm/cache/torch
export LAM_EVAL_ASSET_ROOT=/data/opennwm/cache/lam-eval
export NWM_MODEL_CACHE=/data/opennwm/cache/dreamsim
export WANDB_MODE=offline
