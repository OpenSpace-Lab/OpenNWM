# Copy to .env and edit; load with: set -a; source .env; set +a
LAM_PYTHON=/path/to/lam-env/bin/python
NWM_PYTHON=/path/to/nwm-env/bin/python
NWM_DATA_ROOT=/path/to/navigation_data
NWM_SPLIT_ROOT=/path/to/train_val_splits
NWM_NAVANYWHERE_ROOT=/path/to/navanywhere_frames
NWM_NAVANYWHERE_RECIPE=/path/to/train_recipe.json
NWM_NAVANYWHERE_VAL_RECIPE=/path/to/val_recipe.json
NWM_NAVANYWHERE_VAE_LATENT_ROOT=/path/to/sdvae_cache
NWM_NAVANYWHERE_VAL_PROXY_ROOT=/path/to/val_proxy_cache
WANDB_MODE=offline
